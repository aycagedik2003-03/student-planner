  "terms": {
    "lastUpdated": "Ostatnia aktualizacja: 31.05.2026",
    "s1Title": "1. Akceptacja",
    "s1Body": "Korzystając z naszych usług, akceptujesz poniższe warunki.",
    "s2Title": "2. Warunki Użytkowania",
    "s2Body": "• Musisz mieć co najmniej 18 lat\n• Musisz podać prawdziwe informacje\n• Musisz szanować prawa innych użytkowników\n• Nie wolno Ci angażować się w nielegalne działania\n• Platforma służy wyłącznie do celów osobistych",
    "s3Title": "3. Zabronione Zachowania",
    "s3Body": "• Fałszywe profile lub wprowadzające w błąd informacje\n• Nękanie, groźby lub mowa nienawiści\n• Oszustwa lub phishing\n• Naruszenie praw autorskich\n• Publikowanie nieodpowiednich treści",
    "s4Title": "4. Ograniczenie Odpowiedzialności",
    "s4Body": "Roomski nie gwarantuje, że usługa będzie nieprzerwana lub wolna od błędów. Nie ponosimy odpowiedzialności za spory między użytkownikami.",
    "s5Title": "5. Zmiany",
    "s5Body": "Możemy zmienić te warunki z wcześniejszym powiadomieniem. Zmiany zostaną przesłane e-mailem.",
    "s6Title": "6. Usunięcie Konta",
    "s6Body": "Użytkownicy mogą usunąć swoje konta w dowolnym momencie. Dane zostaną trwale usunięte w ciągu 30 dni.",
    "s7Title": "7. Kontakt",
    "s7Body": "Roomski\nul. [ADRES], 61-000 Poznań, Polska\nE-mail: roomski.app@gmail.com",
    "footer": "Akceptując warunki, potwierdzasz, że je przeczytałeś i rozumiesz."
  },
  "privacy": {
    "lastUpdated": "Ostatnia aktualizacja: 31.05.2026",
    "s1Title": "1. Administrator Danych",
    "s1Body": "Roomski, ul. [ADRES], Poznań, Polska\nKontakt: roomski.app@gmail.com",
    "s2Title": "2. Zbierane Dane",
    "s2Body": "• Imię i nazwisko\n• Adres e-mail\n• Numer telefonu (opcjonalnie)\n• Zdjęcia profilowe\n• Odpowiedzi ankiety osobowości\n• Historia czatów i dopasowania\n• Lokalizacja (jeśli zezwolono)",
    "s3Title": "3. Cel Przetwarzania",
    "s3Body": "• Świadczenie usługi doboru współlokatora\n• Komunikacja między użytkownikami\n• Poprawa bezpieczeństwa platformy\n• Zgodność z wymogami prawnymi",
    "s4Title": "4. Podstawa Prawna",
    "s4Body": "Przetwarzanie danych opiera się na:\n• Twojej zgodzie (RODO Art. 6(1)(a))\n• Wykonaniu umowy (Art. 6(1)(b))\n• Obowiązkach prawnych (Art. 6(1)(c))\n• Uzasadnionych interesach (Art. 6(1)(f))",
    "s5Title": "5. Twoje Prawa",
    "s5Body": "• Prawo dostępu do danych (RODO Art. 15)\n• Prawo do sprostowania (Art. 16)\n• Prawo do usunięcia (Art. 17)\n• Prawo do ograniczenia przetwarzania (Art. 18)\n• Prawo do przenoszenia danych (Art. 20)\n• Prawo do wycofania zgody (Art. 7(3))\n\nWnioski: roomski.app@gmail.com",
    "s6Title": "6. Bezpieczeństwo Danych",
    "s6Body": "Stosujemy szyfrowanie end-to-end (E2E) dla wiadomości.\nWszystkie dane przechowywane są w bezpiecznych centrach danych.",
    "s7Title": "7. Zmiany Polityki",
    "s7Body": "Zastrzegamy sobie prawo do zmian.\nO aktualizacjach poinformujemy Cię e-mailem.",
    "footer": "Pytania: roomski.app@gmail.com"
